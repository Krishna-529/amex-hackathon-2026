# zkd-execute — the EXECUTE plane. Copy to .env.local for local dev outside
# docker-compose (docker-compose.yml sets these directly for the containerized
# run). This is the ONLY process in the whole system that should ever hold
# the values below — zkd-app never has them.

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7234
TEMPORAL_TASK_QUEUE=execute
TEMPORAL_NAMESPACE=default
PORT=8080

# --- OPA sidecar — the authoritative policy check, called before every
# mutating activity. Fail-closed if unreachable. ---
OPA_URL=http://localhost:8181

# --- Duffel test-mode order API (write scope) ---
# No production or sandbox key has ever existed for this project — without
# it, suppliers/duffelWrite.ts runs a realistic, stateful mock automatically.
DUFFEL_ACCESS_TOKEN=

# --- Every other supplier's write scope (LiteAPI, Uber) and Amex VPayment
# have never had a key in this project either; suppliers/mockBookingSupplier.ts
# and payments/vpayment.ts always run the realistic mock. Listed here so the
# swap point is obvious the day a real key exists. ---
LITEAPI_API_KEY=
UBER_API_KEY=
AMEX_VPAY_API_KEY=
AMEX_VPAY_API_SECRET=

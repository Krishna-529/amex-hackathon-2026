{
  "name": "amex-travel-disruption-concierge",
  "version": "1.0.0",
  "private": true,
  "description": "Autonomous Travel-Disruption Concierge — Amex Codestreet 2026 prototype",
  "scripts": {
    "postinstall": "npm --prefix web install --no-audit --no-fund",
    "demo": "tsx scripts/run-demo.ts",
    "demo:fail": "tsx scripts/run-demo.ts --fail",
    "demo:fast": "tsx scripts/run-demo.ts --fast",
    "demo:fail:fast": "tsx scripts/run-demo.ts --fail --fast",
    "artifacts": "tsx scripts/artifacts.ts",
    "capture": "tsx scripts/capture.ts",
    "policy:test": "opa test policy/ -v",
    "stop": "pkill -f 'temporal server start-dev' || true; pkill -f 'opa run --server' || true; echo 'stopped OPA + Temporal'",
    "web:dev": "npm --prefix web run dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@temporalio/activity": "^1.11.8",
    "@temporalio/client": "^1.11.8",
    "@temporalio/common": "^1.11.8",
    "@temporalio/worker": "^1.11.8",
    "@temporalio/workflow": "^1.11.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

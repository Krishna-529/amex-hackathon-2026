# ZKD Concierge - API keys for wiring real sandboxes into the prototype
# Copy to zkd-app/.env.local and fill in the values you obtain.
# See assets/round2-api-requirements.xlsx for signup links and free-tier details.

# --- Payments ---
AMEX_VPAY_API_KEY=
AMEX_VPAY_API_SECRET=
STRIPE_SECRET_KEY=

# --- Weather ---
IMD_API_KEY=

# --- Flight status / schedule ---
AVIATIONSTACK_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
FLIGHTAWARE_API_KEY=
CIRIUM_API_KEY=

# --- OAG (fallback data source if Lumo access never comes through — Lumo's
# own published case study confirms Lumo is itself built on top of OAG's
# schedules/status data, so this is the same raw substrate, just without the
# ML prediction layer on top). One Primary/Secondary pair per subscribed
# product — only FLIGHT_INFO_TRIAL is actually wired to code today (usable
# now: 100 calls total, max 100 flights/call, 14-day trial window). The
# others are Production and show status "submitted" (pending approval), kept
# here so the moment they go live nothing needs re-plumbing. ---
OAG_FLIGHT_INFO_TRIAL_PRIMARY_KEY=
OAG_FLIGHT_INFO_TRIAL_SECONDARY_KEY=
OAG_FLIGHT_INFO_PRIMARY_KEY=
OAG_FLIGHT_INFO_SECONDARY_KEY=
OAG_FLIGHT_INFO_CONNECTIONS_PRIMARY_KEY=
OAG_FLIGHT_INFO_CONNECTIONS_SECONDARY_KEY=
OAG_FLIGHT_INFO_ALERTS_TRIAL_PRIMARY_KEY=
OAG_FLIGHT_INFO_ALERTS_TRIAL_SECONDARY_KEY=
# Serve OAG searches from committed recordings in server/oag-fixtures/ instead
# of the live API. Costs zero trial calls, needs no key, and works on a fresh
# clone — rehearse with this ON, and only turn it off for the live demo. An
# unrecorded route throws rather than returning an empty list, so "no fixture"
# never masquerades as "no flights".
OAG_REPLAY=

OAG_MASTER_DATA_PRIMARY_KEY=
OAG_MASTER_DATA_SECONDARY_KEY=

# --- Booking - flights ---
DUFFEL_ACCESS_TOKEN=
SABRE_CLIENT_ID=
SABRE_CLIENT_SECRET=

# --- Booking - hotels ---
LITEAPI_API_KEY=

# --- Booking - ground ---
UBER_API_KEY=

# --- Reasoning / LLM ---
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=   # not used — team chose Gemini
# OPENAI_API_KEY=      # not used — team chose Gemini

# --- Disruption prediction ---
# The real, self-trained cancellation model (zkd-risk-model/) — not optional.
# Points at zkd-risk-model/src/serve.py locally (default assumed if unset:
# http://localhost:8090) or the deployed scorer endpoint. Without a reachable
# scorer, every flight shows "forecast not available" rather than a number —
# see documentation/design/05-cancellation-risk-model.md.
RISK_MODEL_URL=

# --- Card member profile (preferences, entitlement, payment) ---
# Without this, server/myca.ts returns the same mocked profile for every member.
MYCA_API_KEY=

# --- Session signing ---
# Signs the auth cookie (server/auth/session.ts). Falls back to an insecure
# dev-only constant if unset — set this in any real deployment.
SESSION_SECRET=

# --- Operator console (added 2026-08-21) ---
# /ops and its API routes (trigger disruption, mark-cancelled, demo-reset)
# used to be gated only on "any signed-in member" — a real gap, since any
# demo account (or a real card member's own session) could wipe demo state
# or trigger a real, uncapped autonomous booking on any flight. Now gated by
# a separate operator credential. OPS_ACCESS_KEY is the key an operator
# types in at /ops; OPS_SESSION_SECRET signs the resulting cookie the same
# way SESSION_SECRET signs a member's. Both fall back to insecure dev-only
# constants if unset — set both in any real deployment. Leaving
# OPS_ACCESS_KEY unset makes ops login simply unavailable (fails closed),
# never guessable.
OPS_ACCESS_KEY=
OPS_SESSION_SECRET=

# --- Data layer ---
# Postgres-backed store (server/domain/db.ts). Local default matches
# docker-compose.yml's postgres service — port 5433, not 5432, because this
# machine may already run an unrelated project's Postgres on 5432.
DATABASE_URL=postgres://zkdapp:zkdapp@localhost:5433/zkdapp

# --- No key required (public APIs, used as-is) ---
# AviationStack free tier is used for live flight status (see above).

# --- Member notifications (server/notify/) ---
# Threshold-crossing alerts and rebooking confirmations. Every channel is
# optional and independent: unset ones are skipped and recorded as skipped in
# the notification ledger, never silently treated as delivered. With none set,
# prediction and recovery work exactly as before and nobody is messaged.
#
# Absolute base URL used to build deep links (e.g. https://abc.ngrok-free.app).
# Telegram inline buttons REQUIRE https, so with this unset the link is
# appended to the message body instead of becoming a button.
APP_BASE_URL=
#
# WhatsApp via the Twilio sandbox. The recipient must send the sandbox join
# code once per phone, and the session expires after 24h idle — re-join before
# any demo. Numbers may be bare E.164; the `whatsapp:` prefix is added for you.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
#
# PRODUCTION ONLY — an approved Content Template SID (HX...). WhatsApp forbids a
# business from opening a conversation with free-form text: that is allowed only
# inside the 24h window a customer's own message opens. A real member will never
# send a join code, so reaching them requires a pre-approved template (a flight
# alert is a UTILITY template) plus opt-in collected at card enrolment. Set this
# and the sandbox join dance stops being needed. Unset = free text, sandbox only.
TWILIO_WHATSAPP_CONTENT_SID=
#
# Expo push to the Android app. No key needed unless the Expo project has
# enhanced push security switched on. Device tokens are registered at runtime
# via POST /api/devices, not configured here.
EXPO_ACCESS_TOKEN=
#
# SMS via Fast2SMS — the India-native SMS channel. Twilio cannot deliver SMS to
# a +91 number without a PAID account plus DLT (Entity/Sender/template)
# registration, so SMS uses Fast2SMS's "Quick SMS" route (route "q"): no DLT, no
# sender-ID, reaches DND and non-DND, ~Rs 5/msg against a Rs 50 signup credit.
# Right for demo/internal alerts, NOT production duty-of-care — the sender is a
# random numeric and delivery is patchier at peak hours. Key: fast2sms.com
# dashboard → Dev API. FAST2SMS_TO is the bare 10-digit number (no +91); the
# code strips a country code if you leave one on.
FAST2SMS_API_KEY=
FAST2SMS_TO=

# ── Inbound webhooks: how we learn a flight was cancelled ────────────────────
#
# THE ONE VARIABLE THAT MATTERS. Unset (the default) means the receiver at
# /api/webhooks/flight-status/[provider] is live and fully testable with curl
# against localhost, but NO subscriptions are registered anywhere and detection
# stays on the poller plus member reports. /ops says so in those words.
#
# Set it to a publicly reachable HTTPS origin and subscriptions register on
# boot — and re-register whenever this value changes, which is what makes an
# ephemeral tunnel URL survivable. No trailing slash.
#   deployed:  https://your-app.vercel.app
#   local dev: cloudflared tunnel --url http://localhost:5176   (no account needed)
WEBHOOK_PUBLIC_URL=
#
# A long random string. AeroDataBox does not sign its deliveries, so this is
# registered as a header on the subscription and required on every inbound
# request. Weaker than a signature and deliberately documented as such in
# server/webhooks/verify.ts — but it is what stops an anonymous stranger who
# finds the endpoint from convincing us a flight was cancelled, which now ends
# in a charge. Rotating it is this value plus a re-registration.
WEBHOOK_SHARED_SECRET=
#
# Duffel signs with HMAC-SHA256 over "<timestamp>.<raw body>". From the Duffel
# dashboard when you create the webhook (one per account, not per flight).
# NOTE: order.airline_initiated_change_detected only fires for orders booked
# THROUGH Duffel — every PNR here is seeded, so this lane is correct and will
# stay quiet until booking origination exists.
DUFFEL_WEBHOOK_SECRET=
#
# AeroDataBox Flight Alert PUSH, via RapidAPI (~$5/mo). The lane that actually
# covers this product's case: a ticket bought elsewhere, watched by flight
# number. Credits are charged when a notification is SENT, not delivered, so a
# down endpoint still burns allowance. Check Indian coverage first with
# /health/services/airports/{icao}/feeds before relying on it.
AERODATABOX_API_KEY=

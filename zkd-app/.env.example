# ZKD Concierge - API keys for wiring real sandboxes into the prototype
# Copy to zkd-app/.env.local and fill in the values you obtain.
# See round2-api-requirements.xlsx for signup links and free-tier details.

# --- Payments ---
AMEX_VPAY_API_KEY=
AMEX_VPAY_API_SECRET=
STRIPE_SECRET_KEY=

# --- Weather ---
IMD_API_KEY=

# --- Flight status / schedule ---
AVIATIONSTACK_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
FLIGHTAWARE_API_KEY=
CIRIUM_API_KEY=

# --- Booking - flights ---
DUFFEL_ACCESS_TOKEN=
SABRE_CLIENT_ID=
SABRE_CLIENT_SECRET=

# --- Booking - hotels ---
LITEAPI_API_KEY=

# --- Booking - ground ---
UBER_API_KEY=

# --- Reasoning / LLM ---
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=   # not used — team chose Gemini
# OPENAI_API_KEY=      # not used — team chose Gemini

# --- No key required (public APIs, used as-is) ---
# NOAA Aviation Weather Center: https://aviationweather.gov/data/api/
# Open-Meteo: https://open-meteo.com/

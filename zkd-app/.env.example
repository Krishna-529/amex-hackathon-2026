# ZKD Concierge - API keys for wiring real sandboxes into the prototype
# Copy to zkd-app/.env.local and fill in the values you obtain.
# See assets/round2-api-requirements.xlsx for signup links and free-tier details.

# --- Payments ---
AMEX_VPAY_API_KEY=
AMEX_VPAY_API_SECRET=
STRIPE_SECRET_KEY=

# --- Weather ---
IMD_API_KEY=

# --- Flight status / schedule ---
AVIATIONSTACK_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
FLIGHTAWARE_API_KEY=
CIRIUM_API_KEY=

# --- OAG (fallback data source if Lumo access never comes through — Lumo's
# own published case study confirms Lumo is itself built on top of OAG's
# schedules/status data, so this is the same raw substrate, just without the
# ML prediction layer on top). One Primary/Secondary pair per subscribed
# product — only FLIGHT_INFO_TRIAL is actually wired to code today (usable
# now: 100 calls total, max 100 flights/call, 14-day trial window). The
# others are Production and show status "submitted" (pending approval), kept
# here so the moment they go live nothing needs re-plumbing. ---
OAG_FLIGHT_INFO_TRIAL_PRIMARY_KEY=
OAG_FLIGHT_INFO_TRIAL_SECONDARY_KEY=
OAG_FLIGHT_INFO_PRIMARY_KEY=
OAG_FLIGHT_INFO_SECONDARY_KEY=
OAG_FLIGHT_INFO_CONNECTIONS_PRIMARY_KEY=
OAG_FLIGHT_INFO_CONNECTIONS_SECONDARY_KEY=
OAG_FLIGHT_INFO_ALERTS_TRIAL_PRIMARY_KEY=
OAG_FLIGHT_INFO_ALERTS_TRIAL_SECONDARY_KEY=
OAG_MASTER_DATA_PRIMARY_KEY=
OAG_MASTER_DATA_SECONDARY_KEY=

# --- Booking - flights ---
DUFFEL_ACCESS_TOKEN=
SABRE_CLIENT_ID=
SABRE_CLIENT_SECRET=

# --- Booking - hotels ---
LITEAPI_API_KEY=

# --- Booking - ground ---
UBER_API_KEY=

# --- Reasoning / LLM ---
# Powers two things: server/gemini.ts's explain() (risk-prediction reasoning
# text) AND server/geminiRefine.ts's parsePreferencePrompt() (the member-
# preference "refine" flow). Without this set, both fall back to their
# honest "no fabricated result" path — refine falls back to the unmodified
# deterministic ranker with a note, never a guess.
GEMINI_API_KEY=
# OPENAI_API_KEY=      # not used

# Bedrock (server/bedrock.ts) — an alternate provider for the same refine
# flow, currently PARKED: this account hit an account-wide Bedrock/SageMaker
# restriction ("ValidationException: Operation not allowed") that a support
# ticket hadn't cleared, so server/engine/refine.ts currently imports
# server/geminiRefine.ts instead (see .env.example's GEMINI_API_KEY above).
# bedrock.ts itself is untouched and still tested — swapping back is a
# one-import-line change in refine.ts, plus these four values. Needs real
# AWS credentials (standard SDK credential chain — either these two env
# vars, or `aws configure` / an assumed role) with bedrock:InvokeModel on
# both the inference-profile ARN below and the underlying foundation-model
# ARN it routes to.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_INFERENCE_PROFILE_ARN=

# --- Disruption prediction ---
# thinklumo.com. Without this, server/lumo.ts returns a deterministic mock and
# labels every forecast source: "mock" — nothing pretends to be real.
LUMO_API_KEY=

# --- Card member profile (preferences, entitlement, payment) ---
# Without this, server/myca.ts returns the same mocked profile for every member.
MYCA_API_KEY=

# --- Session signing ---
# Signs the auth cookie (server/auth/session.ts). Falls back to an insecure
# dev-only constant if unset — set this in any real deployment.
SESSION_SECRET=

# --- Operator console auth (server/auth/opsSession.ts) ---
# /ops has no per-user account, but it can trigger real pipeline actions
# across every member's flight, so it needs its own shared credential.
# OPS_ACCESS_KEY is the key an operator types in at /ops/login; OPS_SECRET
# signs the resulting session cookie. Both fall back to insecure dev-only
# constants if unset — required in any real deployment.
OPS_ACCESS_KEY=
OPS_SECRET=

# --- Execution plane (see documentation/architecture/execution-plane.md) ---
# Postgres-backed store (server/domain/db.ts). Local default matches
# docker-compose.yml's postgres service — port 5433, not 5432, because this
# machine may already run an unrelated project's Postgres on 5432.
DATABASE_URL=postgres://zkdapp:zkdapp@localhost:5433/zkdapp
# Temporal frontend the PLAN-side client (server/engine/actExecutor.ts)
# starts workflows against. Local default matches docker-compose.yml — port
# 7234, not 7233, for the same reason as DATABASE_URL above.
TEMPORAL_ADDRESS=localhost:7234
TEMPORAL_TASK_QUEUE=execute
# OPA sidecar PLAN calls for its own early-filter check (never the
# enforcement point — see zkd-shared/src/opaClient.ts).
OPA_URL=http://localhost:8181

# --- No key required (public APIs, used as-is) ---
# AviationStack free tier is used for live flight status (see above).

next-env.d.ts

# --- Local working docs (personal tracking, not a submission deliverable —
# unlike assets/data/round2-api-requirements.xlsx, which IS tracked) ---
known-limitations.xlsx

# --- zkd-risk-model: real historical training data is large and
# re-downloadable (src/download_data.sh); never commit it. Trained model
# artifacts and metrics reports ARE committed — see zkd-risk-model/README.md.
zkd-risk-model/data/raw/
zkd-risk-model/data/processed/
zkd-risk-model/.venv/

# --- OAG trial call-budget counter (process-local state, not source) ---
# Anchored to the repo root, which was not enough: server/decisionLedger.ts
# resolves this directory from process.cwd(), so running the test suite from
# the repo root instead of from zkd-app/ writes it to <root>/server/.state and
# the anchored pattern missed it entirely. Two ledger files reached main that
# way on 2026-08-19. Match at any depth instead.
**/server/.state/

# --- Playwright (test run artifacts, not source) ---
zkd-app/test-results/
zkd-app/playwright-report/
zkd-app/blob-report/

# --- Terraform ---
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.auto.tfvars
